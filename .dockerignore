# Shrinks the build context and keeps secrets / generated files out of it.
# The Dockerfile does `COPY . .` (Go stage) and `COPY web/ ./` (web stage):
# everything below is either regenerated inside the image, platform-specific,
# or private.

# VCS / agent tooling
.git
.gitignore
.zcode
.zcodeignore

# Docs and editor state — ballast for the image
docs
.idea
.vscode
web/.vscode

# Secrets and local env values — never bake into a build context.
# The two templates are re-included so they stay available if ever COPYed.
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# Generated artifacts (all are rebuilt inside the image)
bin
openapi.json
openapi.yaml
web/node_modules
web/dist
web/src/api/schema.ts

# OS / editor noise
*.local
.DS_Store
