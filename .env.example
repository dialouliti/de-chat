# Copy to .env and adjust. Used by docker-compose.yml and the app.

# Address the HTTP server listens on.
SERVER_ADDR=:8080

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://dechat:dechat@db:5432/dechat?sslmode=disable

# Secret used to sign JWTs. MUST be set to a strong random value.
# The server refuses to start unless this is at least 32 bytes long and is
# not the default placeholder below. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token is valid.
JWT_TTL=24h

# Bootstrap administrator account created on first startup if no admin exists.
# If ADMIN_PASSWORD is left empty, a random password is generated and logged once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# CORS: which browser origins may call the API. "*" (default), a single origin
# (https://chat.example.com), or a comma-separated list. The web client needs
# this when it is served from a different origin than the API.
CORS_ORIGIN=*

# --- WebRTC calls (served via GET /api/v1/call/config) ---

# Comma-separated STUN server URLs. Always served to clients.
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN server URLs. Leave empty to disable TURN (STUN-only
# mode; calls then only work when peers can reach each other directly).
# Examples: turn:turn.example.com:3478?transport=udp (public),
#           turn:localhost:3478?transport=udp (local compose stack)
TURN_URLS=

# Shared secret for short-lived TURN credentials (coturn REST API scheme);
# must match coturn's --static-auth-secret. Outside docker compose (e.g.
# `make run` with exported env) REQUIRED when TURN_URLS is set — the server
# refuses to boot otherwise; the server reads no .env file itself, the
# `${VAR:-default}` substitution is docker-compose-only, which fills an empty
# value with the dev default `dechat-dev-turn-secret-change-me` shared by the
# app and coturn services (fine for local dev; set your own for anything
# internet-reachable). The coturn image entrypoint shell-expands every
# command argument, so the value must not contain `$`, backticks or glob
# characters — `openssl rand -base64 32` output is safe.
TURN_SECRET=

# How long generated TURN credentials stay valid (Go duration format).
TURN_TTL=1h

# --- coturn (STUN/TURN service in docker-compose.yml) ---

# Host address the coturn ports (3478 udp+tcp and the 49160-49200/udp relay
# range) are published on. Loopback by default — matching the local usage
# turn:localhost:3478 — because an unset TURN_SECRET falls back to the
# publicly known dev default. Set 0.0.0.0 (or the machine's LAN IPv4) to
# test calls from other devices, and set a strong TURN_SECRET if you do:
# anyone who can reach the ports can mint short-lived credentials and use
# coturn as a relay.
COTURN_BIND_ADDR=127.0.0.1

# --- LiveKit (SFU service in docker-compose.yml) ---

# API key/secret pair of the LiveKit SFU. The Go server will use them to
# mint LiveKit access tokens for group calls (a follow-up card); an empty
# pair means the SFU feature is disabled. They must be set together —
# exactly one of the two makes the server refuse to boot. As with
# TURN_SECRET, the server reads no .env file itself: the `${VAR:-default}`
# substitution is docker-compose-only, and it fills empty values with the
# dev defaults (devkey / dechat-dev-livekit-secret-change-me) shared by the
# app and livekit services — fine for loopback dev, not for anything
# reachable beyond it. Generate your own with:
#   openssl rand -base64 32
# The secret is injected as LIVEKIT_KEYS, which livekit-server parses as
# YAML ("<key>: <secret>"), so the value must not contain ": " (colon+
# space) or leading YAML-special characters — the server crash-loops on
# "Could not parse keys". openssl rand -base64 32 output is safe.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Host address the LiveKit ports (7880/tcp signaling, 7881/tcp ICE-TCP and
# the 50100-50200/udp media range) are published on. Loopback by default —
# an unset LIVEKIT_API_SECRET falls back to the publicly known dev default,
# and anyone reaching the ports could mint room tokens and drive the SFU.
# Set 0.0.0.0 (or the machine's LAN IPv4) to test calls from other devices,
# and set a strong LIVEKIT_API_SECRET when you do. For LAN testing also set
# rtc.node_ip in livekit.yaml to the machine's LAN IP (bridge-network ICE
# advertisement) — see the notes in that file.
LIVEKIT_BIND_ADDR=127.0.0.1

# LiveKit signaling URL handed to clients together with a room call token
# (POST /api/v1/rooms/{id}/call). The URL is consumed by the BROWSER, not by
# the app container, so it must resolve where the browser runs: the default
# matches the loopback-published compose service. To test calls from other
# devices, set the machine's LAN IP here (and LIVEKIT_BIND_ADDR=0.0.0.0);
# use wss:// when the SFU sits behind a TLS edge.
LIVEKIT_URL=ws://localhost:7880

# --- Caddy edge (web service in docker-compose.yml) ---

# Site name the Caddy edge serves. "localhost" (default) makes Caddy issue a
# self-signed certificate from its internal CA — fine for a local stack (use
# `curl -k`; expect a one-time browser warning). Set a real DNS name for a
# public deployment: ports 80/443 must then be reachable from the internet
# and Caddy obtains a Let's Encrypt certificate automatically. An ACME email
# is optional — add a single `email you@example.com` line to the global
# block of the Caddyfile.
DOMAIN=localhost
